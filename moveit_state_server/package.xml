<?xml version='1.0' encoding='UTF-8'?>
<package format="3">
    <name>moveit_state_server</name>
    <version>0.1.0</version>
    <description>The moveit_state_server package (ROS2 port)</description>

    <maintainer email="aljoscha.schmidt@tu-darmstadt.de">Aljoscha Schmidt</maintainer>
    <license>BSD</license>

    <author email="aljoscha.schmidt@tu-darmstadt.de">Aljoscha Schmidt</author>
    <buildtool_depend>ament_cmake</buildtool_depend>

    <build_depend>eigen</build_depend>
    <build_depend>geometry_msgs</build_depend>

    <depend>controller_manager</depend>
    <depend>controller_orchestrator</depend>
    <depend>moveit_core</depend>
    <depend>moveit_ros_planning_interface</depend>
    <depend>moveit_state_server_msgs</depend>
    <depend>rclcpp</depend>

    <exec_depend>joint_state_publisher</exec_depend>
    <exec_depend>moveit_ros_perception</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>

    <test_depend>ament_cmake_gtest</test_depend>
    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
